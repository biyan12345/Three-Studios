{
  "name": "streamplay-studio",
  "private": true,
  "version": "2.5.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node build/index.js",
    "start:server": "node build/index.js",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "desktop:prepare": "npm run desktop:build",
    "desktop:dev": "concurrently -k \"vite dev --host 127.0.0.1 --port 5173\" \"wait-on tcp:5173 && cross-env ELECTRON_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "desktop:build": "vite build",
    "desktop:pack": "npm run desktop:prepare && electron-builder --dir",
    "desktop:dist:mac": "npm run desktop:prepare && electron-builder --mac --arm64",
    "desktop:dist:win": "npm run desktop:prepare && electron-builder --win nsis --x64",
    "desktop:dist:win:arm64": "npm run desktop:prepare && electron-builder --win nsis --arm64"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.streamplay.studio",
    "productName": "Streamplay Studio",
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.devkit.sh/app"
      }
    ],
    "electronUpdaterCompatibility": ">=2.16",
    "directories": {
      "output": "dist-electron",
      "buildResources": "electron-builder"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "mac": {
      "artifactName": "${productName}-${version}-Apple-Silicon.${ext}",
      "extendInfo": {
        "NSCameraUsageDescription": "Streamplay Studio needs camera access to connect to OBS Virtual Camera and other video inputs for preview.",
        "NSMicrophoneUsageDescription": "Streamplay Studio may need microphone access when video devices expose bundled audio inputs."
      },
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "guid": "DD4D2456-E778-5615-AE65-5347C8D92903",
      "uninstallDisplayName": "Streamplay Studio",
      "shortcutName": "Streamplay Studio",
      "deleteAppDataOnUninstall": true
    }
  }
}
